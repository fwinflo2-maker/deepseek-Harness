# --- Agent de contenu ---
# Optionnel : si absent, l'agent utilise des modèles de contenu locaux (pas d'appel API).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Agent de relance email (Brevo, gratuit jusqu'à 300 emails/jour) ---
# Optionnel : si absent, l'agent tourne en mode "dry-run" (écrit les emails dans emails_drafts/ au lieu de les envoyer).
BREVO_API_KEY=
SENDER_EMAIL=hello@nexustechnologies.cloud
SENDER_NAME=Nexus

SITE_URL=https://nexustechnologies.cloud
